{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:kind(regular|flash|training|event)/:id([0-9]+)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*[Kk][Aa][Kk][Aa][Oo][Tt][Aa][Ll][Kk]-[Ss][Cc][Rr][Aa][Pp].*" }],
      "destination": "https://riku-server.store/public/run-preview/:kind/:id"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
