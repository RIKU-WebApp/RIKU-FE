    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.5.0",
    "html-to-image": "^1.11.13",
    "icons": "^1.0.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.536.0",
    "modern-screenshot": "^4.6.5",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-calendar": "^5.1.0",
    "react-datepicker": "^7.6.0",
    "react-day-picker": "^9.6.4",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.2",
