    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "rollup": "^4.28.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^5.4.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
